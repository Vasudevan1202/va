[Unit]
Description=Virtual Atmosphere (VA) - Environmental Monitoring Web Application
After=network.target

[Service]
# User and Group under which the application executes (typically 'pi' or your Pi username)
User=pi
Group=pi

# Path to the application root directory
WorkingDirectory=/home/pi/virtual-atmosphere

# Environment variables
# VA_MODE=live activates hardware I2C sensor reading
# VA_HOST=0.0.0.0 binds to all network interfaces for phone/laptop LAN access
# VA_PORT=5000 sets HTTP port
Environment="PATH=/home/pi/virtual-atmosphere/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
Environment="VA_MODE=live"
Environment="VA_HOST=0.0.0.0"
Environment="VA_PORT=5000"

# Command to execute application using the virtual environment python
ExecStart=/home/pi/virtual-atmosphere/.venv/bin/python app.py

# Restart policy in case of crash or temporary error
Restart=always
RestartSec=5s

# Standard output and error logging to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=virtual-atmosphere

[Install]
WantedBy=multi-user.target
